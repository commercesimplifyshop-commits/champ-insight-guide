{
  "redirects": [
    {
      "source": "/:path((?!ads\\.txt|robots\\.txt).*)",
      "has": [{ "type": "host", "value": "matchupgg.com" }],
      "destination": "https://www.matchupgg.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://matchupgg-api.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/_spa.html" }
  ]
}
